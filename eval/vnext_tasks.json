  "baseline": {
    "semantics": "每条任务都从夹具自己的默认 YAML（下面的 config 字段）出发；读取方必须把它复制到临时目录再用，绝不原地改仓库里的文件。",
    "reset": "逐条独立：上一条任务的目标/候选/累积状态一律不带到下一条；候选永远由「基线 + 本条 operations」重新导出。"
  },
  "measurement_semantics": {
    "unit": "mm",
    "coordinate_reference": "canvas_bottom_left",
    "kinds": {
      "translate": "候选构建相对本任务基线构建，对象 bounds_mm 在声明轴上的下边缘之差（axis=y 取 bounds_mm[1]，axis=x 取 bounds_mm[0]），带符号。",
      "bounds": "对象包围盒在声明轴上的**尺寸**（quantity=size：x → x1-x0，y → y1-y0），绝对值；quantity=min/max/center 时分别取边缘坐标/中心线坐标。",
      "relation": "在候选构建上调用 geometry.measure_relation(关系声明里的 kind, 对应 nodes, axis, anchor, method)，取回 value_mm；关系声明取自同一作用域契约里的同名 relation_id。",
      "text": "文字**锚点**经其 transform 换算到画布的毫米位移（数学几何，不是墨迹包围盒）。",
      "refusal": "不发布：期望的引擎状态/诊断规则；候选配置必须等于基线配置，且不得产生任何新产物。",
      "config_error": "改动后的配置必须被 load_config 拒绝（声明范围 / LOCKED_SCIENCE 复核 / 纵横比或装得下的硬校验），构建都不该开始。"
    },
    "tolerance_basis": {
      "vector_geometry": "折线/文字锚点经 transform 得到的数学几何（毫米），容差 1e-6 mm。",
      "axes_rect_geometry": "由毫米外边距与面板尺寸直接算出的轴对齐外框，容差 1e-6 mm。",
      "envelope_geometry": "轴对齐包围盒的间距/尺寸，容差 1e-6 mm。",
      "text_anchor_geometry": "文字锚点经其 transform 换算到画布的毫米位移（数学几何，不是墨迹），容差 1e-6 mm。",
      "text_rasterization": "文字墨迹的光栅化包围盒，容差 0.05 mm（字体度量 + 抗锯齿），只在必须量文字墨迹时使用。"
    }
  },
  "record_outcome": "本文件只写意图 + 操作 + 期望。实际结果、诊断、耗时由运行器在跑完之后另写，不存在预填的成功/结果字段。",
